# Steel Trading Desk — local dev secrets template
#
# 1. Copy this file to `.env` (it's gitignored).
# 2. Fill in your keys below.
# 3. Build the app in Debug. EnvSeeder reads this file from the bundle on
#    launch and writes the values into Keychain (only if Keychain doesn't
#    already have them — Settings paste-in always wins).
# 4. EnvSeeder is wrapped in `#if DEBUG`, so Release builds NEVER read this
#    file. The file is still bundled in any build, though, so KEEP IT EMPTY
#    BEFORE ARCHIVING FOR TESTFLIGHT / APP STORE — you don't want your key
#    sitting inside an IPA that anyone can unzip.
#
# Format: KEY=value (no quotes, no export, one per line)
# Lines starting with # are ignored.

FINNHUB_API_KEY=your_finnhub_key_here
POLYGON_API_KEY=your_polygon_key_here
