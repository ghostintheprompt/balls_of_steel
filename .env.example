# DEBUG-only local credential reference.
# The app does not read .env directly and .env must not be added to Copy Bundle
# Resources. Run `./scripts/run_local.sh`, which sources this file and launches
# the built app directly so it inherits these as real process environment
# variables (macOS `open`/double-click does not forward shell env to a
# launched .app, so this has to run the binary itself).

# Schwab Trader API. Market data only. Copy fresh from the Schwab Developer
# Portal's App Details page every time -- if "Last Modified Date" there is
# newer than when you last copied these, the old values are stale.
SCHWAB_APP_KEY=
SCHWAB_APP_SECRET=
